# Copy this file to `.env` in the same folder and fill in real values.
# `.env` is gitignored — never commit real credentials.

# Deployed IPMS base URL. Ask the IPMS teammate for the real value once
# IPMS is deployed somewhere reachable from this server (still
# localhost-only in dev as of this writing).
IPMS_BASE_URL=http://localhost/ipms

# Shared API key sent as the X-API-Key header. Must be the exact same
# string as URBAN_PLANNING_API_KEY in IPMS's own .env — get it from the
# IPMS teammate, don't invent a placeholder.
URBAN_PLANNING_API_KEY=
