# Copy this file to `.env` in the same folder and fill in real values.
# `.env` is gitignored — never commit real credentials.
#
# The code defaults already point at the live production IPMS domain, so a
# deployed UPAD works WITHOUT this file. You only need a `.env` to point at
# a different environment (e.g. local XAMPP) or to set the API key.

# Deployed IPMS base URL. The correct inbound path on their side is
# /integrations/urban-planning/inspection-requests.php — do not use
# /api/v1/inspection-requests, that route does not exist and returns 404.
IPMS_BASE_URL=https://ipms.infragovservices.com

# Shared API key sent as the X-API-Key header. Must be the exact same
# string as URBAN_PLANNING_API_KEY in IPMS's own .env — get it from the
# IPMS teammate, don't invent a placeholder. While this is empty, requests
# are still recorded locally as 'pending' but never sent.
URBAN_PLANNING_API_KEY=

# ── Local XAMPP dev (both projects side by side under htdocs) ───────────────
# Uncomment for local testing against the local IPMS checkout:
# IPMS_BASE_URL=http://localhost/ipms_lgu
