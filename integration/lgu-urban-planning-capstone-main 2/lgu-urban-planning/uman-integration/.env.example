# Copy this file to `.env` in the same folder and override values as needed.
# `.env` is gitignored — never commit real credentials.
#
# The values below point at the live production domains. UMAN_API_KEY and
# UMAN_WEBHOOK_SECRET are shared secrets and must stay identical to whatever
# UMAN's own api/integration_config.php actually has configured
# (UPAD_API_KEY / UPAD_WEBHOOK_SECRET), on both local and prod.

# Base URL of the UMAN system.
UMAN_API_URL=https://uman.infragovservices.com

# API key UMAN expects on inbound requests. Must match UPAD_API_KEY in
# UMAN's api/integration_config.php.
UMAN_API_KEY=UPAD_UMAN_INTEGRATION_KEY_2026

# Shared HMAC secret UMAN signs webhook callbacks with. Must match
# UPAD_WEBHOOK_SECRET in UMAN's api/integration_config.php.
UMAN_WEBHOOK_SECRET=UPAD_UMAN_WEBHOOK_SECRET_2026

# URL we give UMAN so it knows where to POST inspection results back to us.
# This must be this project's real physical file path — there is no
# /api/webhooks/ route.
UMAN_WEBHOOK_CALLBACK_URL=https://upad.infragovservices.com/uman-integration/uman_inspection_result.php

# ── Local XAMPP dev (both projects side by side under htdocs) ───────────────
# Uncomment these two and delete the production ones above for local testing:
# UMAN_API_URL=http://localhost/uman_
# UMAN_WEBHOOK_CALLBACK_URL=http://localhost/lgu-urban-planning-capstone/lgu-urban-planning/uman-integration/uman_inspection_result.php
