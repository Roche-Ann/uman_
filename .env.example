# Database Configuration
DB_HOST=localhost
DB_NAME=lgu_utilities
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# PayMongo Configuration (Test Mode)
PAYMONGO_SECRET_KEY=your_paymongo_secret_key
PAYMONGO_PUBLIC_KEY=your_paymongo_public_key
PAYMONGO_MODE=test

# Application Settings
APP_URL=http://localhost/utilities
APP_NAME="LGU Utilities Management"

# Main LGU SSO — must match the value stored for the "uman" row in
# Main LGU's connected_systems table.
MAIN_LGU_SSO_SECRET=

# ---------------------------------------------------------------------------
# Email / OTP (Gmail SMTP + App Password)
# ---------------------------------------------------------------------------
# 1. Enable 2-Step Verification on the Gmail account
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Paste the 16-character app password into MAIL_PASSWORD (spaces OK)
# 4. Set MAILER_DSN (URL-encode @ in the username as %40; remove spaces in password)
#
# Example:
#   MAIL_USERNAME=you@gmail.com
#   MAIL_PASSWORD=xxxx xxxx xxxx xxxx
#   MAILER_FROM=you@gmail.com
#   MAILER_DSN=smtp://you%40gmail.com:xxxxxxxxxxxxxxxx@smtp.gmail.com:587
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAILER_FROM=
MAILER_DSN=
